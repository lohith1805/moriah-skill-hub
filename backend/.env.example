# Copy to .env for local development: `cp .env.example .env` and it runs as-is against the
# docker-compose stack — the infra credentials below (DB, MySQL root, MinIO) already match
# docker-compose.yml and docker/mysql-init/01-users.sql, and JWT_SECRET / TOTP_ENCRYPTION_KEY
# carry throwaway local-only values. The `change_me` entries are third-party accounts you supply
# yourself; the features that use them degrade or are mock-tested until you do.
#
# .env is gitignored. In any deployed environment every value here comes from the platform's
# secret store, never a file — regenerate JWT_SECRET / TOTP_ENCRYPTION_KEY and use real
# database credentials there.

# --- Database (moriah_app — runtime pool, no DDL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moriah_skillhub
DB_USERNAME=moriah_app
DB_PASSWORD=app_dev_only
DB_POOL_MAX=10

# --- Read replica (feature 22 — admin exports and heavy metrics reads target this instead of
# the primary; same moriah_app credentials, docker-compose's mysql-replica service) ---
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=3307
DB_REPLICA_POOL_MAX=10

# --- Flyway (moriah_migrate — DDL, migrations only) ---
MIGRATE_DB_USERNAME=moriah_migrate
MIGRATE_DB_PASSWORD=migrate_dev_only

# --- App ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Redis (wired at feature 03) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (feature 03) ---
# JWT_SECRET must be a real, high-entropy secret in any deployed environment — generate with
# e.g. `openssl rand -base64 64`. HS512 requires at least 64 bytes.
JWT_SECRET=bW9yaWFoLWRldi1qd3QtaHM1MTItc2VjcmV0LWxvY2FsLW9ubHktbm90LWZvci1kZXBsb3llZC1lbnZzLWFiY2QxMg==
JWT_KEY_ID=v1

# --- OAuth2 (feature 05) — register real apps at
# https://console.cloud.google.com/apis/credentials and https://github.com/settings/developers.
# Each app's authorized redirect URI must be
# {baseUrl}/api/v1/auth/oauth2/callback/{google|github}. ---
GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# --- 2FA (feature 05) ---
# Base64-encoded 256-bit (32-byte) AES key — generate with e.g. `openssl rand -base64 32`.
# Must be a real, high-entropy secret in any deployed environment.
TOTP_ENCRYPTION_KEY=bW9yaWFoLWRldi10b3RwLWFlczI1Ni1rZXktbG9jYWw=

# --- Razorpay (feature 07) — register a test-mode account at https://dashboard.razorpay.com.
# WEBHOOK_SECRET is whatever you configure when adding the webhook endpoint on their dashboard;
# it does not need to be "real" for local testing — HMAC verification is symmetric, so any value
# you set here and use to sign a test payload verifies correctly. ---
RAZORPAY_KEY_ID=change_me
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# --- Stripe (feature 07) — register a test-mode account at https://dashboard.stripe.com.
# SUCCESS_URL/CANCEL_URL are frontend routes Stripe redirects the browser to; this backend
# doesn't serve them. ---
STRIPE_SECRET_KEY=change_me
STRIPE_WEBHOOK_SECRET=change_me
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success
STRIPE_CANCEL_URL=http://localhost:5173/checkout/cancelled

# --- Scheduled jobs (feature 07 onward) ---
SUBSCRIPTION_EXPIRY_CRON=0 0 3 * * *
JOBS_ZONE=Asia/Kolkata

# --- docker-compose only — MySQL root superuser, never used by the application itself ---
MYSQL_ROOT_PASSWORD=root_dev_only

# --- MinIO / S3 (feature 08) — local dev talks to the docker-compose MinIO service; a real
# deployment sets S3_ACCESS_KEY/S3_SECRET_KEY to real IAM credentials and leaves S3_ENDPOINT
# blank (or points it at Cloudflare R2 — no code change needed either way). ---
MINIO_ROOT_USER=skillhub_minio
MINIO_ROOT_PASSWORD=minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Locally, set these to the same values as MINIO_ROOT_USER/MINIO_ROOT_PASSWORD above — kept as
# separate literal vars rather than a ${MINIO_ROOT_USER} reference since not every tool that
# loads a .env file expands cross-references the way docker-compose does.
S3_BUCKET=moriah-skillhub
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=skillhub_minio
S3_SECRET_KEY=minio_dev_only

# --- Notification dispatch (feature 08) — no real SendGrid/Meta developer account exists yet;
# dispatch logic is unit-tested against mocked clients, same as Razorpay/Stripe/OAuth2. ---
SENDGRID_API_KEY=change_me
SENDGRID_FROM_ADDRESS=no-reply@moriahskillhub.example
SENDGRID_FROM_NAME=Moriah Skill Hub
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=change_me
WHATSAPP_ACCESS_TOKEN=change_me
WHATSAPP_APP_SECRET=change_me
NOTIFICATION_REAPER_CRON=0 * * * * *

# --- Email verification / password reset links (feature 08) — {token} is substituted with the
# raw token; these are frontend routes, this backend doesn't serve them. The Vite dev server is
# :5173 — only change these if your SPA runs elsewhere. ---
EMAIL_VERIFICATION_URL_TEMPLATE=http://localhost:5173/verify-email?token={token}
PASSWORD_RESET_URL_TEMPLATE=http://localhost:5173/reset-password?token={token}
STAFF_INVITE_URL_TEMPLATE=http://localhost:5173/accept-invite?token={token}
CERTIFICATE_VERIFY_URL_TEMPLATE=http://localhost:5173/verify/{code}

# --- GitHub REST API (feature 12) — a server-side personal access token (repo:read scope is
# enough; never the OAuth2 app's client-id/secret above, that's a different credential for a
# different purpose). Generate one at https://github.com/settings/tokens. ---
GITHUB_API_TOKEN=change_me
